      "panel-7": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Latest AI Assessment per Incident",
          "description": "One latest nonauthoritative AI assessment per deterministic incident in the selected range. This is not authoritative lifecycle state.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-clickhouse-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "efvaztlrk8ow0a"
                      },
                      "spec": {
                        "editorType": "sql",
                        "format": 1,
                        "meta": {
                          "builderOptions": {
                            "columns": [],
                            "database": "observability",
                            "filters": [],
                            "limit": 200,
                            "meta": {
                              "otelEnabled": false
                            },
                            "mode": "list",
                            "orderBy": [],
                            "queryType": "table",
                            "table": "ai_updates"
                          }
                        },
                        "pluginVersion": "4.20.0",
                        "queryType": "table",
                        "rawSql": "SELECT\n    max(updates.timestamp) AS \"Time\",\n    argMax(multiIf(length(updates.device) > 0, updates.device, length(devices.device) > 0, devices.device, 'unavailable - legacy record'), tuple(updates.timestamp, updates.run_id)) AS \"Device\",\n    argMax(updates.severity, tuple(updates.timestamp, updates.run_id)) AS \"Severity\",\n    argMax(updates.status, tuple(updates.timestamp, updates.run_id)) AS \"Assessment\",\n    argMax(updates.title, tuple(updates.timestamp, updates.run_id)) AS \"Title\",\n    argMax(updates.occurrence_count, tuple(updates.timestamp, updates.run_id)) AS \"Occurrences\",\n    arrayStringConcat(argMax(updates.tags, tuple(updates.timestamp, updates.run_id)), ',') AS \"Tags\",\n    updates.incident_id AS \"Incident ID\"\nFROM observability.ai_updates AS updates\nLEFT ANY JOIN observability.ai_result_devices AS devices USING (run_id)\nWHERE updates.timestamp >= $__fromTime\n  AND updates.timestamp <= $__toTime\nGROUP BY updates.incident_id\nORDER BY \"Time\" DESC\nLIMIT 100"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.1.1",
            "spec": {
              "options": {
                "cellHeight": "md",
                "showHeader": true,
                "enablePagination": true,
                "frozenColumns": {
                  "left": 2
                },
                "footer": {
                  "countRows": false,
                  "enablePagination": true,
                  "fields": "",
                  "reducer": [
                    "sum"
                  ],
                  "show": false
                }
              },
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "left",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "filterable": true,
                    "inspect": false,
                    "minWidth": 70,
                    "wrapHeaderText": true
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Time"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "dateTimeFromNow"
                      },
                      {
                        "id": "custom.width",
                        "value": 140
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Device"
                    },
                    "properties": [
                      {
                        "id": "custom.width",
                        "value": 190
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Severity"
                    },
                    "properties": [
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "color-background",
                          "mode": "basic"
                        }
                      },
                      {
                        "id": "custom.width",
                        "value": 105
                      },
                      {
                        "id": "mappings",
                        "value": [
                          {
                            "type": "value",
                            "options": {
                              "critical": {
                                "color": "red",
                                "index": 0,
                                "text": "CRITICAL"
                              },
                              "high": {
                                "color": "orange",
                                "index": 1,
                                "text": "HIGH"
                              },
                              "medium": {
                                "color": "yellow",
                                "index": 2,
                                "text": "MEDIUM"
                              },
                              "low": {
                                "color": "blue",
                                "index": 3,
                                "text": "LOW"
                              },
                              "informational": {
                                "color": "green",
                                "index": 4,
                                "text": "INFO"
                              },
                              "": {
                                "color": "gray",
                                "index": 5,
                                "text": "UNSPECIFIED"
                              }
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Assessment"
                    },
                    "properties": [
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "color-background",
                          "mode": "basic"
                        }
                      },
                      {
                        "id": "custom.width",
                        "value": 170
                      },
                      {
                        "id": "mappings",
                        "value": [
                          {
                            "type": "value",
                            "options": {
                              "action_required": {
                                "color": "red",
                                "index": 0,
                                "text": "ACTION REQUIRED"
                              },
                              "monitor": {
                                "color": "blue",
                                "index": 1,
                                "text": "MONITOR"
                              },
                              "resolved_no_action": {
                                "color": "green",
