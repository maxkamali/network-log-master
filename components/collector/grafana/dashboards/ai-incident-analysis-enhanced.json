                            "queryType": "table",
                            "table": "ai_updates"
                          }
                        },
                        "pluginVersion": "4.20.0",
                        "queryType": "table",
                        "rawSql": "SELECT\n    updates.timestamp AS \"Time\",\n    multiIf(length(updates.device) > 0, updates.device, length(devices.device) > 0, devices.device, 'unavailable - legacy record') AS \"Device\",\n    updates.severity AS \"Severity\",\n    updates.status AS \"Assessment\",\n    updates.title AS \"Title\",\n    updates.body AS \"Explanation\",\n    updates.occurrence_count AS \"Occurrences\",\n    arrayStringConcat(updates.tags, ',') AS \"Tags\",\n    updates.model AS \"Model\",\n    updates.incident_id AS \"Incident ID\",\n    updates.run_id AS \"Run ID\"\nFROM observability.ai_updates AS updates\nLEFT ANY JOIN observability.ai_result_devices AS devices USING (run_id)\nWHERE updates.timestamp >= $__fromTime\n  AND updates.timestamp <= $__toTime\nORDER BY updates.timestamp DESC\nLIMIT 200"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
