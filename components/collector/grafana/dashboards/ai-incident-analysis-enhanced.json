      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "AI Updates Over Time",
          "description": "Validated result volume by hour. Use the dashboard time picker to zoom.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-clickhouse-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "efvaztlrk8ow0a"
                      },
                      "spec": {
                        "editorType": "sql",
                        "format": 2,
                        "meta": {
                          "builderOptions": {
                            "columns": [],
                            "database": "observability",
                            "filters": [],
                            "limit": 200,
                            "meta": {
                              "otelEnabled": false
                            },
                            "mode": "list",
                            "orderBy": [],
                            "queryType": "time_series",
                            "table": "ai_updates"
                          }
                        },
                        "pluginVersion": "4.20.0",
                        "queryType": "time_series",
                        "rawSql": "SELECT\n    toStartOfInterval(timestamp, INTERVAL 1 HOUR) AS time,\n    count() AS ai_updates\nFROM observability.ai_updates\nWHERE timestamp >= $__fromTime\n  AND timestamp <= $__toTime\nGROUP BY time\nORDER BY time"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.1.1",
            "spec": {
              "options": {
