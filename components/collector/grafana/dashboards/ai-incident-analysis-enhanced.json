                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-clickhouse-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "efvaztlrk8ow0a"
                      },
                      "spec": {
                        "editorType": "sql",
                        "format": 1,
                        "meta": {
                          "builderOptions": {
                            "columns": [],
                            "database": "observability",
                            "filters": [],
                            "limit": 200,
                            "meta": {
                              "otelEnabled": false
                            },
                            "mode": "list",
                            "orderBy": [],
                            "queryType": "table",
                            "table": "ai_updates"
                          }
                        },
                        "pluginVersion": "4.20.0",
                        "queryType": "table",
                        "rawSql": "SELECT\n    if(severity = '', 'unspecified', severity) AS severity,\n    count() AS ai_updates\nFROM observability.ai_updates\nWHERE timestamp >= $__fromTime\n  AND timestamp <= $__toTime\nGROUP BY severity\nORDER BY ai_updates DESC"
                      }
                    },
