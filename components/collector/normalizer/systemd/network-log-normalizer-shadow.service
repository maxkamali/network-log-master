[Unit]
Description=Network log normalizer durable shadow cycle
After=vector.service
ConditionPathIsDirectory=/var/spool/vector-ai
ConditionPathIsDirectory=/var/spool/network-log-normalizer-shadow
ConditionPathIsReadWrite=/var/lib/network-log-normalizer

[Service]
Type=oneshot
User=network-log-normalizer
Group=network-log-normalizer
SupplementaryGroups=vector
ExecStart=/usr/local/sbin/network-log-normalizer-shadow run
UMask=0027

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @privileged @resources

ReadOnlyPaths=/var/spool/vector-ai
ReadOnlyPaths=/etc/network-log-normalizer/platform-inventory.json
ReadWritePaths=/var/spool/network-log-normalizer-shadow
ReadWritePaths=/var/lib/network-log-normalizer

TimeoutStartSec=15min
TasksMax=64
MemoryMax=1G
CPUQuota=100%
