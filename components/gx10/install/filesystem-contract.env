# Public-safe fixed paths and neutral runtime identity for clean GX10 rebuilds.

GX10_RUNTIME_USER=network-log-agent
GX10_RUNTIME_GROUP=network-log-agent
GX10_RUNTIME_HOME=/var/lib/network-log-gx10
GX10_SSH_DIR=/var/lib/network-log-gx10/.ssh
GX10_PRIVATE_KEY_PATH=/var/lib/network-log-gx10/.ssh/spool-reader.key
GX10_KNOWN_HOSTS_PATH=/var/lib/network-log-gx10/.ssh/known_hosts
GX10_SPOOL_DIR=/var/spool/network-log-gx10
GX10_INCOMING_DIR=/var/spool/network-log-gx10/incoming
GX10_PROCESSED_DIR=/var/spool/network-log-gx10/processed
GX10_TEMP_DIR=/var/spool/network-log-gx10/tmp
GX10_STATE_DIR=/var/lib/network-log-gx10/state
GX10_DATABASE_PATH=/var/lib/network-log-gx10/state/events.sqlite3
GX10_LIBEXEC_DIR=/usr/local/libexec/network-log-gx10
