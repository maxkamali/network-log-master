[Unit]
Description=Network log GX10 deterministic correlation pipeline
After=network-log-gx10.service

[Service]
Type=oneshot
User=network-log-agent
Group=network-log-agent

ExecStart=/usr/local/libexec/network-log-gx10/run-correlation.py
TimeoutStartSec=10min

UMask=0077
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
CPUQuota=100%
MemoryMax=1G
TasksMax=32

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes

ProtectSystem=strict
ProtectHome=yes

ReadWritePaths=/var/lib/network-log-gx10

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes

RestrictNamespaces=yes
LockPersonality=yes

CapabilityBoundingSet=
AmbientCapabilities=

RestrictAddressFamilies=AF_UNIX
