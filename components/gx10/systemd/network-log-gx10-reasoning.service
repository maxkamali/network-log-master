[Unit]
Description=Network log GX10 managed local reasoning
After=network-log-gx10-correlation.service ollama.service

[Service]
Type=oneshot
User=network-log-agent
Group=network-log-agent

ExecStart=/usr/local/libexec/network-log-gx10/run-managed-reasoning.py
TimeoutStartSec=3min

UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=100%
MemoryMax=1G
TasksMax=32

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes

ProtectSystem=strict
ProtectHome=yes

ReadWritePaths=/var/lib/network-log-gx10

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes

RestrictNamespaces=yes
LockPersonality=yes

CapabilityBoundingSet=
AmbientCapabilities=

RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
