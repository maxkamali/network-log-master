[Unit]
Description=Network log GX10 local reasoning-result outbox
After=network-log-gx10-reasoning.service

[Service]
Type=oneshot
User=network-log-agent
Group=network-log-agent

ExecStart=/usr/local/libexec/network-log-gx10/run-result-outbox.py
TimeoutStartSec=2min

UMask=0077
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=50%
MemoryMax=256M
TasksMax=16

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes

ProtectSystem=strict
ProtectHome=yes

ReadWritePaths=/var/lib/network-log-gx10/result-outbox

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes

RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=

RestrictAddressFamilies=AF_UNIX
