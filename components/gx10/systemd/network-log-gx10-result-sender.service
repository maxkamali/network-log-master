[Unit]
Description=Network log GX10 write-only result sender
After=network-online.target network-log-gx10-result-outbox.service
Wants=network-online.target
ConditionPathExists=/etc/network-log-gx10/result-sender.json

[Service]
Type=oneshot
User=network-log-agent
Group=network-log-agent

ExecStart=/usr/local/libexec/network-log-gx10/run-result-sender.py
TimeoutStartSec=45s

UMask=0077
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=25%
MemoryMax=128M
TasksMax=16

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes

ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid

ReadWritePaths=/var/lib/network-log-gx10/result-outbox
ReadOnlyPaths=/etc/network-log-gx10/result-sender.json
ReadOnlyPaths=/var/lib/network-log-gx10/.ssh/result-writer.key
ReadOnlyPaths=/var/lib/network-log-gx10/.ssh/result-writer-known_hosts
InaccessiblePaths=/var/lib/network-log-gx10/state/events.sqlite3

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes

RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=

RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
